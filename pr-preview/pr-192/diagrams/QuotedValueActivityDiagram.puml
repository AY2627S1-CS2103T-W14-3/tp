@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:Take the text after the prefix,
up to the next recognised prefix;
:Trim the text;

if () then ([text starts with "])
    :Look for the next "
    without a \ before it;
    if () then ([closing " found])
        :Treat prefixes between
        the quotes as text;
        if () then ([only spaces up to
        the next prefix])
            :Replace each \" with ";
            :Trim the quoted content;
        else ([other text])
            :Throw ParseException
            (text after quote);
            stop
        endif
    else ([no closing "])
        :Throw ParseException
        (missing closing quote);
        stop
    endif
else ([else])
    if () then ([each " has a \ before it])
        :Replace each \" with ";
    else ([else])
        :Throw ParseException
        (bare quote);
        stop
    endif
endif
:Store the value under the prefix;
stop
@enduml
