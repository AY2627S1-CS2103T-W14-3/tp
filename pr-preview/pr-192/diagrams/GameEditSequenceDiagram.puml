@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF

participant ":GameEditCommand" as Command LOGIC_COLOR
participant "model:ModelManager" as Model MODEL_COLOR
participant "target:ListedFriend" as Target MODEL_COLOR
participant "friend:Friend" as Friend MODEL_COLOR

[-> Command : execute(model)
activate Command
Command -> Model : resolveFriend(index)
activate Model
create Target
Model -> Target : create(friend)
activate Target
Target --> Model
deactivate Target
Model --> Command : target
deactivate Model
Command -> Target : friend()
activate Target
Target --> Command : friend
deactivate Target
note right of Command
Find the one matching game and build
its replacement. Reject a rename that
collides with another game. A failure
here leaves the model unchanged.
end note
Command -> Friend : withGames(games)
activate Friend
Friend --> Command : updated
deactivate Friend
Command -> Model : setFriend(target, updated)
activate Model
Model --> Command
deactivate Model
[<-- Command : result
deactivate Command
@enduml
