@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class FriendListPanel
Class FriendCard
Class FriendDetailsPanel
Class GameDetailsCard
Class StatusBarFooter
Class CommandBox
Class TagPane
Class TagLabel
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

' Inheritance from UiPart is shown separately in UiPartClassDiagram to keep these arrows readable.
UiManager .up.|> Ui
' A small spacer keeps endpoint multiplicities close to, but clear of, arrowheads in Smetana.
UiManager -down-> "1\n<size:6> </size>" MainWindow
MainWindow *-down-> "1\n<size:6> </size>" CommandBox
MainWindow *-down-> "1\n<size:6> </size>" ResultDisplay
MainWindow *-down-> "1\n<size:6> </size>" FriendListPanel
MainWindow *-down-> "1\n<size:6> </size>" FriendDetailsPanel
MainWindow *-down-> "1\n<size:6> </size>" StatusBarFooter
MainWindow --> "0..1\n<size:6> </size>" HelpWindow

FriendListPanel -down-> "*\n<size:6> </size>" FriendCard
FriendDetailsPanel *-down-> "*\n<size:6> </size>" GameDetailsCard

FriendCard --> "1\n<size:6> </size>" TagPane
FriendDetailsPanel --> "1\n<size:6> </size>" TagPane
TagPane --> "*\n<size:6> </size>" TagLabel

FriendCard ..> Model
FriendDetailsPanel ..> Model
GameDetailsCard ..> Model
UiManager -right-> Logic
MainWindow -right-> Logic

FriendListPanel -[hidden]left- HelpWindow
HelpWindow -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter
@enduml
