@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "GameMates Storage" #F4F6F6{
Class JsonGameMatesStorage
Class JsonSerializableGameMates
Class JsonAdaptedFriend
Class JsonAdaptedTag
Class JsonAdaptedGame
Class JsonAdaptedGameName
Class JsonAdaptedUsername
Class JsonAdaptedMeta
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
' A small spacer keeps endpoint multiplicities close to, but clear of, arrowheads in Smetana.
StorageManager -down-> "1\n<size:6> </size>" JsonUserPrefsStorage
StorageManager -down-> "1\n<size:6> </size>" JsonGameMatesStorage

JsonGameMatesStorage ..> JsonSerializableGameMates
' The role sits with the multiplicity so that it stays on the outer side of the left arrow.
' Text in the package's background colour is invisible. The padding moves the role clear of the
' line and the multiplicity next to the arrowhead. The blank label keeps the two arrows apart.
JsonSerializableGameMates --> "friends<color:#F4F6F6>________________</color>\n<color:#F4F6F6>__________________________</color>*" JsonAdaptedFriend : <color:#F4F6F6>___</color>
JsonSerializableGameMates --> "0..1" JsonAdaptedFriend : myself
JsonAdaptedFriend --> "*\n<size:6> </size>" JsonAdaptedTag
JsonAdaptedFriend --> "*\n<size:6> </size>" JsonAdaptedGame
JsonAdaptedGame --> "1\n<size:6> </size>" JsonAdaptedGameName
JsonAdaptedGame --> "1\n<size:6> </size>" JsonAdaptedUsername
JsonAdaptedGame --> "*\n<size:6> </size>" JsonAdaptedMeta

@enduml
