@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam minClassWidth 100
skinparam nodesep 30
skinparam ranksep 50
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyGameMates" as ReadOnlyGameMates
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class GameMates
Class ModelManager {
    -friendListScope: FriendListScope
}
enum FriendListScope <<enumeration>> {
    ACTIVE
    ARCHIVED
    SEARCH
}
Class UserPrefs

Class UniqueFriendList
Class Friend {
    -archived: boolean
    +isArchived(): boolean
    +withArchived(archived: boolean): Friend
}
Class Email
Class Name
Class Phone
Class Tag
Class Game
Class GameName
Class Username

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

' Only archive-related members are expanded in this partial class diagram.
show Friend members
show FriendListScope members
show ModelManager members
hide FriendListScope methods

GameMates .up.|> ReadOnlyGameMates

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyGameMates
ModelManager -left-> "1" GameMates
ModelManager -right-> "1" UserPrefs
' The enum is the type of the attribute above, as in the course enumeration examples.
ModelManager -[hidden]down-> FriendListScope
UserPrefs .up.|> ReadOnlyUserPrefs

' A small spacer keeps endpoint multiplicities close to, but clear of, arrowheads in Smetana.
GameMates *--> "1\n<size:6> </size>" UniqueFriendList
UniqueFriendList --> "*\n<size:6> </size>" Friend : all
GameMates --> "1\n<size:6> </size>" Friend : myself
Friend *--> Name
Friend *--> Phone
Friend *--> Email
Friend *--> "*\n<size:6> </size>" Tag
Friend *--> "*\n<size:6> </size>" Game
Game *--> "1\n<size:6> </size>" GameName
Game *--> "1\n<size:6> </size>" Username

Friend -[hidden]up--> I
UniqueFriendList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email

ModelManager --> "*\n<size:6> </size>" Friend : filtered
@enduml
