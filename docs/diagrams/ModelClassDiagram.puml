@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyGameMates" as ReadOnlyGameMates
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class GameMates
Class ModelManager
Class UserPrefs

Class UniqueFriendList
Class Friend
Class Email
Class Name
Class Phone
Class Tag
Class Game
Class GameName
Class Username

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

GameMates .up.|> ReadOnlyGameMates

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyGameMates
ModelManager -left-> "1" GameMates
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

GameMates *--> "1" UniqueFriendList
UniqueFriendList --> "~* all" Friend
GameMates --> "1 myself" Friend
Friend *--> Name
Friend *--> Phone
Friend *--> Email
Friend *--> "*" Tag
Friend *--> "*" Game
Game *--> "1" GameName
Game *--> "1" Username

Friend -[hidden]up--> I
UniqueFriendList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email

ModelManager --> Friend : ~* filtered
@enduml
