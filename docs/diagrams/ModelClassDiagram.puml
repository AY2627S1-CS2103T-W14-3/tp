@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam minClassWidth 100
skinparam nodesep 30
skinparam ranksep 50
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyGameMates" as ReadOnlyGameMates
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class GameMates
Class ModelManager
enum FriendListScope <<enumeration>> {
    ACTIVE
    ARCHIVED
    SEARCH
}
Class UserPrefs

Class UniqueFriendList
Class Friend {
    -archived: boolean
    -pinned: boolean
}
Class Email
Class Name
Class Phone
Class Tag
Class Game
Class GameName
Class Username
Class Meta
Class MetaKey
Class MetaValue

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

' Only archive and pin attributes are expanded in this partial class diagram.
show Friend attributes
show FriendListScope members
hide FriendListScope methods

GameMates .up.|> ReadOnlyGameMates

ModelManager .up.|> Model
' Smetana ignores nodesep, so blank labels keep these horizontal arrows long enough to read.
Model .right.> ReadOnlyUserPrefs : <color:#FFFFFF>____</color>
Model .left.> ReadOnlyGameMates : <color:#FFFFFF>____</color>
ModelManager -left-> "1" GameMates : <color:#FFFFFF>______</color>
ModelManager -right-> "1" UserPrefs : <color:#FFFFFF>______</color>
ModelManager --> "1\n<size:6> </size>" FriendListScope
UserPrefs .up.|> ReadOnlyUserPrefs

' A small spacer keeps endpoint multiplicities close to, but clear of, arrowheads in Smetana.
GameMates *--> "1\n<size:6> </size>" UniqueFriendList
UniqueFriendList --> "*\n<size:6> </size>" Friend : all
GameMates --> "1\n<size:6> </size>" Friend : myself
' Immutable field objects can be shared, so these links do not imply exclusive ownership.
Friend --> "1\n<size:6> </size>" Name
Friend --> "1\n<size:6> </size>" Phone
Friend --> "1\n<size:6> </size>" Email
Friend --> "*\n<size:6> </size>" Tag
Friend --> "*\n<size:6> </size>" Game
Game --> "1\n<size:6> </size>" GameName
Game --> "1\n<size:6> </size>" Username
Game --> "*\n<size:6> </size>" Meta
Meta --> "1\n<size:6> </size>" MetaKey
Meta --> "1\n<size:6> </size>" MetaValue

Friend -[hidden]up--> I
UniqueFriendList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email

ModelManager --> "*\n<size:6> </size>" Friend : filtered
@enduml
