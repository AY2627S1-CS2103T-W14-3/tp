@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":GameMatesParser" as GameMatesParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

participant ":Storage" as Storage STORAGE_COLOR

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> GameMatesParser : parseCommand("delete 1")
activate GameMatesParser

create DeleteCommandParser
GameMatesParser -> DeleteCommandParser
activate DeleteCommandParser

DeleteCommandParser --> GameMatesParser
deactivate DeleteCommandParser

GameMatesParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser

create DeleteCommand
DeleteCommandParser -> DeleteCommand
activate DeleteCommand

DeleteCommand --> DeleteCommandParser :
deactivate DeleteCommand

DeleteCommandParser --> GameMatesParser : d
deactivate DeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteCommandParser -[hidden]-> GameMatesParser
destroy DeleteCommandParser

GameMatesParser --> LogicManager : d
deactivate GameMatesParser

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getFilteredFriendList()
activate Model
Model --> DeleteCommand : displayedFriends
deactivate Model
note right of DeleteCommand: Resolve index 1 to a Friend\nin the displayed list.

DeleteCommand -> Model : deleteFriend(friendToDelete)
activate Model

Model --> DeleteCommand
deactivate Model

create CommandResult
DeleteCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteCommand
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

LogicManager -> Model : getGameMates()
Model --> LogicManager : gameMates
LogicManager -> Storage : saveGameMates(gameMates)
Storage --> LogicManager

[<--LogicManager : r
deactivate LogicManager
@enduml
