@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedGameMates" as VersionedGameMates MODEL_COLOR
end box

[-> Model : undoGameMates()
activate Model

Model -> VersionedGameMates : undo()
activate VersionedGameMates

VersionedGameMates -> VersionedGameMates :resetData(ReadOnlyGameMates)
VersionedGameMates --> Model :
deactivate VersionedGameMates

[<-- Model
deactivate Model

@enduml
